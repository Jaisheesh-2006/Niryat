{
  "mcpServers": {
    "paypal": {
      "command": "node",
      "args": ["scripts/paypal-mcp.mts"],
      "env": {
        "PAYPAL_ACCESS_TOKEN": "${PAYPAL_ACCESS_TOKEN}",
        "PAYPAL_ENVIRONMENT": "SANDBOX"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
