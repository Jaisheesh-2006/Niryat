{
  "mcpServers": {
    "paypal": {
      "command": "node",
      "args": ["scripts/paypal-mcp.mts"],
      "env": {
        "PAYPAL_ENVIRONMENT": "SANDBOX"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@0.4.0"]
    },
    "ag-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["ag-mcp"],
      "env": {}
    }
  }
}
