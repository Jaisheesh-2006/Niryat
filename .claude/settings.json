{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(corepack pnpm *)",
      "PowerShell(pnpm *)",
      "PowerShell(pnpm.cmd *)",
      "PowerShell(corepack.cmd pnpm *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show *)",
      "PowerShell(git show *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/out/**)",
      "Read(**/coverage/**)",
      "Read(**/.turbo/**)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-hook.mts", "block-env"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-hook.mts", "format"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
