{
  "name": "niryat",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@niryat/web --filter=@niryat/api",
    "build": "turbo run build",
    "typecheck": "tsc -p scripts/tsconfig.json && turbo run typecheck",
    "lint": "biome check . && turbo run lint",
    "format": "biome check --write .",
    "test": "node --test scripts/*.test.mts && turbo run test",
    "verify": "tsc -p scripts/tsconfig.json && biome check . && node scripts/check-scaffold.mts && node --test scripts/*.test.mts && turbo run typecheck lint test",
    "db:generate": "pnpm --filter @niryat/db db:generate",
    "db:migrate": "pnpm --filter @niryat/db db:migrate",
    "seed:judge": "pnpm --filter @niryat/db seed:judge",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
