{
  "name": "@niryat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run --no-file-parallelism",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "sync:payments": "tsx src/sync.ts",
    "seed:fira-demo": "tsx src/seed-fira-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@niryat/agent": "workspace:*",
    "@niryat/config": "workspace:*",
    "@niryat/db": "workspace:*",
    "@niryat/paypal": "workspace:*",
    "@niryat/rules": "workspace:*",
    "@niryat/shared": "workspace:*",
    "aws4fetch": "1.0.20",
    "hono": "4.13.13",
    "pdf-lib": "1.17.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@niryat/config": "workspace:*",
    "tsx": "4.23.15"
  }
}
